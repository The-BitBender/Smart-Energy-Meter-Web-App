{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/telemetry/ingest",
      "destination": "/api/telemetry/ingest"
    },
    {
      "source": "/api/telemetry/latest",
      "destination": "/api/telemetry/ingest"
    },
    {
      "source": "/api/telemetry/meters",
      "destination": "/api/telemetry/ingest"
    },
    {
      "source": "/api/meters/sync",
      "destination": "/api/telemetry/ingest"
    },
    {
      "source": "/api/meters",
      "destination": "/api/telemetry/ingest"
    },
    {
      "source": "/api/meters/(.*)",
      "destination": "/api/telemetry/ingest"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
