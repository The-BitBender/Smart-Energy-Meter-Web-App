rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isMeterOwner(meterId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/meters/$(meterId)) &&
        get(/databases/$(database)/documents/meters/$(meterId)).data.ownerUid == request.auth.uid;
    }

    // User profile document & settings subcollection
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.email is string;
      allow delete: if isOwner(userId);

      match /settings/{settingId} {
        allow read, write: if isValidId(settingId) && isOwner(userId);
      }
    }

    // Meters collection
    match /meters/{meterId} {
      allow get: if isValidId(meterId);
      allow list: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || resource.data.ownerUid == 'demo_user');
      allow create: if isValidId(meterId) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() <= 128 &&
        request.resource.data.relayState in ['ON', 'OFF'] &&
        (
          (isSignedIn() && request.resource.data.ownerUid == request.auth.uid) ||
          (request.resource.data.apiKey is string && request.resource.data.apiKey.size() == 16 && request.resource.data.ownerUid is string && request.resource.data.ownerUid.size() <= 128)
        );
      allow update: if isValidId(meterId) &&
        (!('relayState' in request.resource.data) || request.resource.data.relayState in ['ON', 'OFF']) &&
        (
          (isSignedIn() && (resource.data.ownerUid == request.auth.uid || resource.data.ownerUid == 'demo_user') && request.resource.data.ownerUid == request.auth.uid) ||
          (resource.data.apiKey is string && resource.data.apiKey.size() == 16 && request.resource.data.apiKey == resource.data.apiKey && request.resource.data.ownerUid == resource.data.ownerUid)
        );
      allow delete: if isValidId(meterId) && isSignedIn() && (resource.data.ownerUid == request.auth.uid || resource.data.ownerUid == 'demo_user');

      // Telemetry logs subcollection
      match /telemetry/{telemetryId} {
        allow get, list: if isValidId(meterId) && isSignedIn() &&
          (resource == null || resource.data.ownerUid == request.auth.uid || resource.data.ownerUid == 'demo_user' || isMeterOwner(meterId));
        allow create: if isValidId(meterId) && isValidId(telemetryId) &&
          (
            (isSignedIn() && (request.resource.data.ownerUid == request.auth.uid || isMeterOwner(meterId))) ||
            (exists(/databases/$(database)/documents/meters/$(meterId)) && request.resource.data.ownerUid == get(/databases/$(database)/documents/meters/$(meterId)).data.ownerUid)
          );
        allow update, delete: if isValidId(meterId) && isValidId(telemetryId) && isSignedIn() &&
          (resource.data.ownerUid == request.auth.uid || resource.data.ownerUid == 'demo_user' || isMeterOwner(meterId));
      }

      // Anomalies subcollection
      match /anomalies/{anomalyId} {
        allow get, list: if isValidId(meterId) && isSignedIn() &&
          (resource == null || resource.data.ownerUid == request.auth.uid || resource.data.ownerUid == 'demo_user' || isMeterOwner(meterId));
        allow create: if isValidId(meterId) && isValidId(anomalyId) &&
          (
            (isSignedIn() && (request.resource.data.ownerUid == request.auth.uid || isMeterOwner(meterId))) ||
            (exists(/databases/$(database)/documents/meters/$(meterId)) && request.resource.data.ownerUid == get(/databases/$(database)/documents/meters/$(meterId)).data.ownerUid)
          );
        allow update: if isValidId(meterId) && isValidId(anomalyId) && isSignedIn() &&
          (resource.data.ownerUid == request.auth.uid || resource.data.ownerUid == 'demo_user' || isMeterOwner(meterId)) &&
          request.resource.data.status in ['ACTIVE', 'RESOLVED', 'ACKNOWLEDGED'];
        allow delete: if isValidId(meterId) && isValidId(anomalyId) && isSignedIn() &&
          (resource.data.ownerUid == request.auth.uid || resource.data.ownerUid == 'demo_user' || isMeterOwner(meterId));
      }
    }
  }
}
